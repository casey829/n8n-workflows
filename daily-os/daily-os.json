    {
      "parameters": {
        "jsCode": "// DAILY OS — PRODUCTION ROUTER (V2.0)\n\n// 1. ROBUST WHOOP DATA EXTRACTION\nconst whoopNode = $('Fetch Live Whoop Recovery').first();\nconst rawData = whoopNode ? whoopNode.json : {};\n\n/** \n * Logic: If Whoop returns a list (records[]), take the first one. \n * If it returns a single object, use that. \n */\nconst latestRecord = (rawData.records && rawData.records.length > 0) \n    ? rawData.records[0] \n    : rawData;\n\nconst recoveryScore = latestRecord.score?.recovery_score ?? 85;\nconst strainScore = latestRecord.score?.strain ?? 12.4;\n\n// 2. AI PLAN PARSING\nconst aiNode = $('AI Plan the Day').first();\nlet aiPlan = { workoutDifficulty: \"Standard\", morningSpeechType: \"Standard Motivation\", workMusicVibe: \"Standard Instrumental\" };\n\ntry {\n    const rawText = aiNode?.json?.content?.parts?.[0]?.text?.trim() || \"{}\";\n    aiPlan = JSON.parse(rawText);\n} catch (error) {\n    console.log(\"AI parsing failed, using recovery defaults.\");\n}\n\n// 3. PLAYLIST ROUTING - replace with your own playlist IDs\nlet workoutPlaylistUrl = \"https://open.spotify.com/playlist/YOUR_WORKOUT_STANDARD_PLAYLIST\";\nlet workoutLabel = \"💪 Standard\";\n\nif (aiPlan.workoutDifficulty === \"Beast Mode\") {\n    workoutPlaylistUrl = \"https://open.spotify.com/playlist/YOUR_WORKOUT_INTENSE_PLAYLIST\";\n    workoutLabel = \"🔥 Beast Mode\";\n} else if (aiPlan.workoutDifficulty === \"Recovery\") {\n    workoutPlaylistUrl = \"https://open.spotify.com/playlist/YOUR_WORKOUT_RECOVERY_PLAYLIST\";\n    workoutLabel = \"🧘 Recovery\";\n}\n\n// 4. FINAL OUTPUT PAYLOAD\nreturn [{\n    json: {\n        recoveryScore: recoveryScore,\n        strainScore: strainScore,\n        workoutLabel: workoutLabel,\n        workoutPlaylistUrl: workoutPlaylistUrl,\n        \n        // Static URLs (No changes made)\n        wakeUpUrl: \"https://open.spotify.com/playlist/YOUR_WAKEUP_PLAYLIST\",\n        deepWorkUrl: \"https://open.spotify.com/playlist/YOUR_DEEPWORK_PLAYLIST\",\n        journalUrl: \"https://open.spotify.com/playlist/YOUR_JOURNAL_PLAYLIST\",\n        commuteToWorkUrl: \"https://open.spotify.com/playlist/YOUR_COMMUTE_OUT_PLAYLIST\",\n        commuteHomeUrl: \"https://open.spotify.com/playlist/YOUR_COMMUTE_HOME_PLAYLIST\",\n        sleepUrl: \"https://open.spotify.com/playlist/YOUR_JOURNAL_PLAYLIST\",\n        \n        // Keep as URI for the Spotify Node to avoid 404\n        spotifyWakeUpUri: \"spotify:playlist:YOUR_WAKEUP_PLAYLIST\"\n    }\n}];"
      },
      "id": "e029f3f0-205e-416d-bec4-7baec6b23f62",
